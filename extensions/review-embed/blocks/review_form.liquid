{% assign product_id = product.id | prepend: 'gid://shopify/Product/' | url_encode %}

<div class="product-reviews-form">
  <h2>Write a Review</h2>

  {% if customer %}
    <form id="review-form" action="{{ routes.root_url }}apps/reviewer-9000/review/{{ product_id }}" method="POST">
      <input type="hidden" name="customerId" value="{{ customer.id }}">

      <div class="rating-select">
        <label for="rating">Rating:</label>
        <div class="star-rating">
          <input type="radio" id="star5" name="rating" value="5" required>
          <label for="star5" title="5 stars">5</label>
          <input type="radio" id="star4" name="rating" value="4">
          <label for="star4" title="4 stars">4</label>
          <input type="radio" id="star3" name="rating" value="3">
          <label for="star3" title="3 stars">3</label>
          <input type="radio" id="star2" name="rating" value="2">
          <label for="star2" title="2 stars">2</label>
          <input type="radio" id="star1" name="rating" value="1">
          <label for="star1" title="1 star">1</label>
        </div>
      </div>

      <div class="review-text">
        <label for="message">Your Review:</label>
        <textarea id="message" name="message" rows="4" required></textarea>
      </div>

      <button type="submit" class="submit-review">Submit Review</button>

      <div id="review-result" class="hidden"></div>
    </form>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // For debugging - log what star SVGs are available
        console.log('Star empty path:', '{{ "star-empty.svg" | asset_url }}');
        console.log('Star filled path:', '{{ "star-filled.svg" | asset_url }}');

        // Set up form submission handler
        document.getElementById('review-form').addEventListener('submit', async function(e) {
          e.preventDefault();

          const form = e.target;
          const resultDiv = document.getElementById('review-result');
          const formData = new FormData(form);

          // Debug log
          console.log("Rating selected:", formData.get('rating'));
          console.log("Submitting to:", form.action);

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              body: formData
            });

            const result = await response.json();
            console.log("Response received:", result);

            if (result.success) {
              resultDiv.innerHTML = '<div class="success-message">Thank you for your review! It will appear after moderation.</div>';
              form.reset();
            } else {
              resultDiv.innerHTML = '<div class="error-message">Error: ' + (result.error || 'Failed to submit review') + '</div>';
            }
          } catch (error) {
            console.error("Submission error:", error);
            resultDiv.innerHTML = '<div class="error-message">Error submitting review. Please try again.</div>';
          }

          resultDiv.classList.remove('hidden');
        });
      });
    </script>
  {% else %}
    <div class="login-prompt">
      <p>Please <a href="{{ routes.account_login_url }}">sign in</a> to leave a review.</p>
    </div>
  {% endif %}
</div>

<style>
  .product-reviews-form {
    margin: 30px 0;
    padding: 20px;
    border: 1px solid #e5e5e5;
    border-radius: 5px;
  }

  /* Star rating using CSS instead of SVG images for reliability */
  .star-rating {
    display: inline-flex;
    flex-direction: row-reverse;
    margin-bottom: 15px;
  }

  .star-rating input {
    display: none;
  }

  .star-rating label {
    cursor: pointer;
    width: 30px;
    height: 30px;
    position: relative;
    margin-right: 5px;
    color: #ccc;
    font-size: 30px;
    line-height: 1;
  }

  .star-rating label:before {
    content: "★";
    position: absolute;
    top: 0;
    left: 0;
  }

  .star-rating input:checked ~ label,
  .star-rating label:hover,
  .star-rating label:hover ~ label {
    color: #ffb700;
    transition: 0.2s;
  }

  /* Alternative: using background SVG if available */
  .using-svg .star-rating label {
    font-size: 0;
    background: url('{{ "star-empty.svg" | asset_url }}') no-repeat center;
    background-size: contain;
  }

  .using-svg .star-rating input:checked ~ label,
  .using-svg .star-rating label:hover,
  .using-svg .star-rating label:hover ~ label {
    background-image: url('{{ "star-filled.svg" | asset_url }}');
  }

  .review-text textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    margin-bottom: 15px;
  }

  .submit-review {
    background-color: #4A90E2;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
  }

  .submit-review:hover {
    background-color: #357ABD;
  }

  .success-message {
    color: green;
    padding: 10px;
    margin-top: 15px;
    background-color: #e8f5e9;
    border-radius: 4px;
  }

  .error-message {
    color: red;
    padding: 10px;
    margin-top: 15px;
    background-color: #ffebee;
    border-radius: 4px;
  }

  .hidden {
    display: none;
  }

  .login-prompt {
    text-align: center;
    padding: 15px;
    background-color: #f5f5f5;
    border-radius: 4px;
  }
</style>

<script>
  // Check if SVG assets exist and add class accordingly
  document.addEventListener('DOMContentLoaded', function() {
    function checkImageExists(url, callback) {
      const img = new Image();
      img.onload = function() { callback(true); };
      img.onerror = function() { callback(false); };
      img.src = url;
    }

    checkImageExists('{{ "star-empty.svg" | asset_url }}', function(exists) {
      if (exists) {
        document.querySelector('.product-reviews-form').classList.add('using-svg');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Product Reviews Form",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Review Form Settings"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Show review form",
      "default": true
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form title",
      "default": "Write a Review"
    }
  ]
}
{% endschema %}
